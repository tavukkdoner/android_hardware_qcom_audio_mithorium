cc_library_shared {
    name: "libqcomvoiceprocessing",
    relative_install_path: "soundfx",
    vendor: true,
    owner: "qti",

    srcs: [
        "voice_processing.c",
    ],

    cflags: [
        "-fvisibility=hidden",
        "-Werror",
    ] + select(soong_config_variable("qtiaudio", "target_board_auto"), {
        "true": ["-D_FORTIFY_SOURCE=2", "-fstack-protector-strong"],
        default: [],
    }),

    include_dirs: [
        "system/media/audio_effects/include",
    ],

    header_libs: [
        "libhardware_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],

    sanitize: {
        integer_overflow: true,
    },
}
